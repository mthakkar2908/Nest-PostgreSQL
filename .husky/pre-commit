#!/usr/bin/env sh
set -e

echo '🏗️👷 Styling, lint and build checks before commit'

# Choose package manager (npm default, yarn if yarn.lock exists)
if [ -f "yarn.lock" ]; then
  CMDS="yarn"
  FORMAT_CMD="yarn format"
  LINT_CMD="yarn lint"
  BUILD_CMD="yarn build"
else
  CMDS="npm"
  FORMAT_CMD="npm run format"
  LINT_CMD="npm run lint"
  BUILD_CMD="npm run build"
fi

echo "Using package manager: $CMDS"

echo '➡️ Running format'
$FORMAT_CMD

echo '➡️ Running lint'
$LINT_CMD

echo '➡️ Running build'
$BUILD_CMD

echo '✅ All checks passed. Proceed with commit.'
