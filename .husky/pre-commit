#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Checking code format with Prettier..."
npx prettier --check .

if [ $? -ne 0 ]; then
  echo "❌ Prettier format failed! Please run: npm run format"
  exit 1
else
  echo "✅ Prettier format is correct"
fi

echo "🧹 Running ESLint..."
npm run lint

if [ $? -ne 0 ]; then
  echo "❌ ESLint failed! Fix errors before committing"
  exit 1
else
  echo "✅ ESLint passed"
fi

echo "🏗️ Building project..."
npm run build

if [ $? -ne 0 ]; then
  echo "❌ Build failed! Fix errors before committing"
  exit 1
else
  echo "✅ Build successful"
fi

echo "🚀 All checks passed! Ready to commit."